# Prism Backend Configuration
# =============================================================================
# This file should be copied from the root .env.example
# See the root .env.example for full documentation
# =============================================================================

# Server Configuration
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=development
BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# Database - SQLite (default)
DATABASE_URL=./data/prism.db

# PostgreSQL (optional - set PGHOST to enable)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=prism
# PGPASSWORD=your_secure_password
# PGDATABASE=prism
# PGSSL=disable

# Security (CHANGE THESE IN PRODUCTION)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Guest Mode
GUEST_MODE_ENABLED=false

# WorkOS Authentication (optional)
# WORKOS_API_KEY=sk_...
# WORKOS_CLIENT_ID=client_...
# WORKOS_REDIRECT_URI=http://localhost:8080/api/v1/auth/callback
# WORKOS_COOKIE_PASSWORD=minimum-32-character-secret-key-here
# WORKOS_WEBHOOK_SECRET=whsec_...

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/api/v1/github/callback
GITHUB_WEBHOOK_ENABLED=false
GITHUB_WEBHOOK_SECRET=
# GITHUB_APP_ID=123456
# GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----...

# LLM Providers
OLLAMA_HOST=http://localhost:11434
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Stripe Payments (optional)
# STRIPE_SECRET_KEY=sk_...
# STRIPE_PUBLISHABLE_KEY=pk_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Analytics
POSTHOG_ENABLED=false
POSTHOG_API_KEY=
POSTHOG_ENDPOINT=https://app.posthog.com
POSTHOG_BATCH_SIZE=10
POSTHOG_FLUSH_INTERVAL=30s

# Sandbox Configuration
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=0.5
SANDBOX_TIMEOUT=60s

# Code Runner
CODE_RUNNER_ENABLED=true
CODE_RUNNER_DOCKER_MODE=false
CODE_RUNNER_MEMORY_LIMIT=512m
CODE_RUNNER_CPU_LIMIT=0.5
CODE_RUNNER_TIMEOUT=5m

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_DIR=./data/uploads

# Integrations
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=

SLACK_ENABLED=false
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# PostHog Analytics
# Get your API key from https://app.posthog.com/project/settings
POSTHOG_ENABLED=false
POSTHOG_API_KEY=
POSTHOG_ENDPOINT=https://app.posthog.com
POSTHOG_BATCH_SIZE=10
POSTHOG_FLUSH_INTERVAL=30s
# Project ID for PostHog query tools (for error tracking)
POSTHOG_PROJECT_ID=
