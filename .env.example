# Prism Configuration
# =============================================================================
# Copy this file to .env and configure the values for your environment
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=8080
HOST=0.0.0.0
# Set to "production" for production deployments
ENVIRONMENT=development
BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# SQLite (default)
DATABASE_URL=./data/prism.db

# PostgreSQL (optional - set PGHOST to enable)
# When PGHOST is set, PostgreSQL is used instead of SQLite
# PGHOST=localhost
# PGPORT=5432
# PGUSER=prism
# PGPASSWORD=your_secure_password
# PGDATABASE=prism
# PGSSL=disable  # Options: disable, require, verify-full

# =============================================================================
# SECURITY - CRITICAL: Configure these before production deployment
# =============================================================================
# ENCRYPTION_KEY: Used to encrypt sensitive data (API keys, tokens)
# REQUIRED in production. Data is lost on restart if not set!
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# JWT_SECRET: Used to sign authentication tokens
# REQUIRED in production. Must be at least 32 characters.
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-in-production

JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Guest Mode: Allows unauthenticated access. DISABLE in production!
GUEST_MODE_ENABLED=false

# =============================================================================
# AUTHENTICATION - WorkOS (optional)
# =============================================================================
# WorkOS provides enterprise SSO, directory sync, and more
# Sign up at: https://workos.com
# WORKOS_API_KEY=sk_...
# WORKOS_CLIENT_ID=client_...
# WORKOS_REDIRECT_URI=http://localhost:8080/api/v1/auth/callback
# WORKOS_COOKIE_PASSWORD must be at least 32 characters for session encryption
# Generate with: openssl rand -base64 32
# WORKOS_COOKIE_PASSWORD=minimum-32-character-secret-key-here
# WORKOS_WEBHOOK_SECRET=whsec_...

# =============================================================================
# GITHUB CONFIGURATION
# =============================================================================
# GitHub OAuth - Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/api/v1/github/callback

# GitHub App (optional) - For advanced GitHub integration
# Create at: https://github.com/settings/apps
# GITHUB_APP_ID=123456
# GITHUB_PRIVATE_KEY should contain the full PEM-encoded private key
# GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----...

# GitHub Webhooks
GITHUB_WEBHOOK_ENABLED=false
# Secret for verifying GitHub webhook signatures (set in GitHub webhook settings)
GITHUB_WEBHOOK_SECRET=

# =============================================================================
# LLM PROVIDERS
# =============================================================================
# Ollama - Local LLM support
OLLAMA_HOST=http://localhost:11434

# OpenRouter - Access 200+ models including Llama, Mistral, DeepSeek, Qwen, and more
# Get your API key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...
# Optional: Site URL for attribution (shows up in OpenRouter dashboard)
# OPENROUTER_SITE_URL=https://your-prism-instance.com

# Docker Sandbox
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=0.5
SANDBOX_TIMEOUT=60s
# Preview URL for sandbox (defaults to FRONTEND_URL if not set)
SANDBOX_PREVIEW_URL=

# =============================================================================
# CODE RUNNER
# =============================================================================
# For automatic code execution on webhook events
CODE_RUNNER_ENABLED=true
# Use Docker for sandboxed execution (recommended for production)
CODE_RUNNER_DOCKER_MODE=false
CODE_RUNNER_MEMORY_LIMIT=512m
CODE_RUNNER_CPU_LIMIT=0.5
CODE_RUNNER_TIMEOUT=5m

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# =============================================================================
# CORS
# =============================================================================
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# FILE UPLOADS
# =============================================================================
# Maximum upload size in bytes (default: 10MB)
UPLOAD_MAX_SIZE=10485760
UPLOAD_DIR=./data/uploads

# =============================================================================
# INTEGRATIONS (optional)
# =============================================================================

# Discord
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=

# Slack
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
